}

function renderAirQualityDrilldown(d) {
  const aqi = d.european_aqi;
  const band = d.band || {};
  const pollutants = Object.values(d.pollutants || {}).sort((a,b) => b.who_ratio - a.who_ratio);

  // Plain-English AQI explanation
  let aqiExplain = '';
  if (aqi == null) aqiExplain = 'Data unavailable.';
  else if (aqi < 20) aqiExplain = '<strong>Really clean air.</strong> You could be in the countryside on a windy day after rain. No reason to change any plans.';
  else if (aqi < 40) aqiExplain = '<strong>Good air quality.</strong> This is normal/healthy outdoor air for the UK. Go run, cycle, push the pram — all fine.';
  else if (aqi < 60) aqiExplain = '<strong>OK but not pristine.</strong> You might smell it if you\'re sensitive. Fine for most people. If you have asthma and you\'re doing hard exercise, maybe keep it shorter.';
  else if (aqi < 80) aqiExplain = '<strong>Noticeably poor.</strong> Sensitive folk (kids, elderly, asthma/heart) should take it easy outdoors. Healthy adults are fine but might notice it on a long run.';
  else if (aqi < 100) aqiExplain = '<strong>Genuinely bad air.</strong> Cut outdoor exercise if you can help it. Keep windows shut. Vulnerable people should stay inside.';
  else aqiExplain = '<strong>Severe pollution.</strong> Avoid outdoor activity. Close windows, use air filtration if you have it. This is unusual for Ayrshire.';

  // What's in the air right now
  const topPollutants = pollutants.filter(p => p.who_ratio >= 0.3);
  let composition = '';
  if (topPollutants.length === 0) {
    composition = 'All pollutants are well below safe thresholds — genuinely clean air.';
  } else if (d.dominant_pollutant) {
    const dom = d.dominant_pollutant;
    composition = `The air is mostly clean, but <strong>${dom.name}</strong> is the main thing showing up. That comes from <em>${dom.sources.slice(0,3).join(', ').toLowerCase()}</em>.`;
  }

  // Per-pollutant explainer cards
  const pollutantCards = pollutants.map(p => {
    const barColor = p.who_ratio<0.5?'#22c55e':p.who_ratio<1?'#84cc16':p.who_ratio<2?'#eab308':'#ef4444';
    const status = p.who_ratio < 0.5 ? 'Well below safe level' : p.who_ratio < 1 ? 'Below safe level' : p.who_ratio < 2 ? 'Above WHO guideline' : 'Well above guideline';
    return `<div style="padding:14px;border:1px solid var(--line);border-radius:10px;margin-bottom:10px;background:var(--surface)">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
        <div><strong style="font-size:15px">${p.name}</strong> <span style="color:var(--text-mute);font-size:12px">${p.full_name}</span></div>
        <div style="font-size:20px;font-weight:700;font-variant-numeric:tabular-nums">${p.value}<span style="font-size:11px;color:var(--text-mute);margin-left:3px">μg/m³</span></div>
      </div>
      <div style="background:var(--surface-2);height:6px;border-radius:3px;margin:10px 0 6px;overflow:hidden"><div style="height:100%;width:${Math.min(200,p.who_ratio*100)}%;background:${barColor}"></div></div>
      <div style="font-size:11px;color:var(--text-mute);display:flex;justify-content:space-between">
        <span>${(p.who_ratio*100).toFixed(0)}% of WHO guideline</span>
        <span style="color:${barColor};font-weight:600">${status}</span>
      </div>
      <div style="font-size:13px;color:var(--text-dim);margin-top:10px;line-height:1.5">${p.description}</div>
      <div style="font-size:12px;color:var(--text-mute);margin-top:8px;line-height:1.5"><strong>Comes from:</strong> ${p.sources.join(', ')}.</div>
      <div style="font-size:12px;color:var(--text-mute);margin-top:4px;line-height:1.5"><strong>Health impact:</strong> ${p.health}</div>
    </div>`;
  }).join('');

  // Practical advice
  const advisory = d.advisory || {};
  const practicalAdvice = advisory.general ? `<div style="padding:14px;background:var(--surface-2);border-radius:10px;margin:16px 0">
    <div style="font-size:12px;color:var(--text-mute);text-transform:uppercase;letter-spacing:0.08em;font-weight:700;margin-bottom:8px">What should you do?</div>
    <div style="font-size:14px;margin-bottom:6px"><strong>Most people:</strong> ${advisory.general}</div>
    <div style="font-size:13px;color:var(--text-dim)"><strong>If you have asthma, heart disease, are pregnant, elderly, or have young kids:</strong> ${advisory.sensitive}</div>
  </div>` : '';

  return `
    <h2>Air Quality</h2>
    <div class="sky-big">AQI ${aqi||'–'}</div>
    <div style="display:inline-block;font-size:13px;font-weight:700;padding:4px 12px;border-radius:100px;background:${band.color||'#888'}22;color:${band.color||'#888'};margin-top:6px">${band.label||''}</div>

    <div style="font-size:14px;line-height:1.6;margin:16px 0">${aqiExplain}</div>
    <div style="font-size:13px;line-height:1.6;color:var(--text-dim);margin:12px 0">${composition}</div>

    ${practicalAdvice}

    <h3 style="font-size:12px;margin:20px 0 10px;color:var(--text-mute);text-transform:uppercase;letter-spacing:0.08em">What's in the air · Everything measured</h3>
    <div style="font-size:12px;color:var(--text-mute);margin-bottom:12px;line-height:1.5">
      We measure five pollutants. Each bar shows how much of that pollutant is in the air compared to the
      World Health Organisation's safe limit. A full green bar means you're at the safe threshold — under that is good.
    </div>
    ${pollutantCards}

    <h3 style="font-size:12px;margin:20px 0 10px;color:var(--text-mute);text-transform:uppercase;letter-spacing:0.08em">How the AQI number works</h3>
    <div style="font-size:12px;color:var(--text-dim);line-height:1.6">
      The European Air Quality Index (EAQI) runs from 0 (pristine) to 100+ (hazardous). It's not arbitrary — it's
      calculated from the worst-performing pollutant of the five. If PM2.5 is fine but NO₂ is through the roof,
      the overall AQI reflects the NO₂ problem.
      <br><br>
      <strong>0-20 Good</strong> · <strong>20-40 Fair</strong> · <strong>40-60 Moderate</strong> ·
      <strong>60-80 Poor</strong> · <strong>80-100 Very Poor</strong> · <strong>100+ Extremely Poor</strong>
      <br><br>
      Data source: Copernicus Atmosphere Monitoring Service (CAMS) via Open-Meteo. Updated hourly.
      The nearest monitoring point to Ayrshire produces the values shown.
    </div>
  `;
}

