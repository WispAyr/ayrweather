<script type="module">
// ── Location registry ──
const LOCATIONS = ['ayr','troon','prestwick','kilmarnock','irvine','largs','maybole','girvan','cumnock'];
const LOC_NAMES = {ayr:'Ayr',troon:'Troon',prestwick:'Prestwick',kilmarnock:'Kilmarnock',irvine:'Irvine',largs:'Largs',maybole:'Maybole',girvan:'Girvan',cumnock:'Cumnock'};
let currentLoc = 'ayr';

// ── WMO codes ──
const WMO_ICONS = {0:'☀️',1:'🌤️',2:'⛅',3:'☁️',45:'🌫️',48:'🌫️',51:'🌦️',53:'🌦️',55:'🌧️',56:'🌨️',57:'🌨️',61:'🌧️',63:'🌧️',65:'🌧️',66:'🌨️',67:'🌨️',71:'❄️',73:'❄️',75:'❄️',77:'🌨️',80:'🌦️',81:'🌧️',82:'⛈️',85:'🌨️',86:'🌨️',95:'⛈️',96:'⛈️',99:'⛈️'};
const WMO_DESC = {0:'Clear sky',1:'Mainly clear',2:'Partly cloudy',3:'Overcast',45:'Fog',48:'Icy fog',51:'Light drizzle',53:'Drizzle',55:'Heavy drizzle',56:'Freezing drizzle',57:'Heavy freezing drizzle',61:'Light rain',63:'Rain',65:'Heavy rain',66:'Freezing rain',67:'Heavy freezing rain',71:'Light snow',73:'Snow',75:'Heavy snow',77:'Snow grains',80:'Light showers',81:'Showers',82:'Violent showers',85:'Snow showers',86:'Heavy snow showers',95:'Thunderstorm',96:'Thunderstorm w/ hail',99:'Heavy thunderstorm w/ hail'};
const WIND_DIRS = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];

// ── Mood palette by weather code ──
const MOODS = {
  clear:  { m1:'#0b1220', m2:'#1b3a6e', m3:'#2c5aa8', a:'#ffb545' },  // sun-kissed
  cloud:  { m1:'#0b1220', m2:'#1f2d45', m3:'#334864', a:'#6ea8ff' },  // slate
  rain:   { m1:'#081422', m2:'#173047', m3:'#204e6f', a:'#6ea8ff' },  // deep blue
  snow:   { m1:'#0e1826', m2:'#2a3e5c', m3:'#4a6a96', a:'#d4e3ff' },  // icy
  fog:    { m1:'#111a28', m2:'#2a3545', m3:'#475568', a:'#9bb4d4' },  // grey
  storm:  { m1:'#0a0d1a', m2:'#2a1b48', m3:'#4a2b78', a:'#b48bff' },  // dramatic
};
function moodFor(code) {
  if (code == null) return MOODS.cloud;
  if ([95,96,99].includes(code)) return MOODS.storm;
  if (code === 0 || code === 1) return MOODS.clear;
  if ([45,48].includes(code)) return MOODS.fog;
  if (code >= 71 && code <= 86 && code !== 80 && code !== 81 && code !== 82) return MOODS.snow;
  if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return MOODS.rain;
  return MOODS.cloud;
}
function applyMood(code) {
  const m = moodFor(code);
  const r = document.documentElement.style;
  r.setProperty('--mood-1', m.m1);
  r.setProperty('--mood-2', m.m2);
  r.setProperty('--mood-3', m.m3);
  r.setProperty('--accent', m.a);
  r.setProperty('--accent-soft', m.a + '26');
}

// ── Helpers ──
const fmt = (v,d=1) => v != null ? Number(v).toFixed(d) : '–';
const wmoIcon = c => WMO_ICONS[c] ?? '🌡️';
const wmoDesc = c => WMO_DESC[c] ?? 'Unknown';
const windDir = d => d==null ? '–' : WIND_DIRS[Math.round(d/22.5) % 16];
const fmtTime = iso => new Date(iso).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',timeZone:'Europe/London'});
const fmtHour = iso => { const h = new Date(iso).getHours(); return h===0?'12a':h<12?`${h}a`:h===12?'12p':`${h-12}p`; };
const dayName = ds => ds === new Date().toISOString().split('T')[0] ? 'Today' : new Date(ds+'T12:00:00').toLocaleDateString('en-GB',{weekday:'long'});
const dateFmt = ds => new Date(ds+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short'});
const kphToMph = k => k==null ? null : k * 0.621371;

// ── Render location bar ──
function renderLocbar() {
  const bar = document.getElementById('locbar');
  bar.innerHTML = LOCATIONS.map(k => `<button class="loc-pill${k===currentLoc?' active':''}" data-loc="${k}">${LOC_NAMES[k]}</button>`).join('');
  bar.querySelectorAll('.loc-pill').forEach(b => b.addEventListener('click', () => {
    currentLoc = b.dataset.loc;
    bar.querySelectorAll('.loc-pill').forEach(p => p.classList.toggle('active', p.dataset.loc===currentLoc));
    loadAll();
  }));
}

// ── Hero ──
function renderHero(loc, cur, daily) {
  const code = cur.weather_code;
  applyMood(code);
  const sunrise = daily?.sunrise?.[0];
  const sunset = daily?.sunset?.[0];
  const tMax = daily?.temperature_2m_max?.[0];
  const tMin = daily?.temperature_2m_min?.[0];
  const el = document.getElementById('hero-content');
  el.classList.remove('fade-in'); void el.offsetWidth; el.classList.add('fade-in');
  el.innerHTML = `
    <div class="hero-head">
      <span>📍 Ayrshire, Scotland · ${new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}</span>
      <span class="live">Live</span>
    </div>
    <h1 class="hero-city">${loc.name}</h1>
    <div class="hero-desc">${wmoDesc(code)}</div>
    <div class="hero-row">
      <div class="hero-temp">
        ${fmt(cur.temperature_2m,0)}<span class="unit">°</span>
        <span class="icon">${wmoIcon(code)}</span>
      </div>
      <div class="hero-summary">
        <div class="hero-stat">
          <div class="hero-stat-label">Wind</div>
          <div class="hero-stat-value">${fmt(cur.wind_speed_10m,0)}<small>mph</small></div>
          <div class="hero-stat-sub">${windDir(cur.wind_direction_10m)} · G ${fmt(cur.wind_gusts_10m,0)}</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-label">Feels</div>
          <div class="hero-stat-value">${fmt(cur.apparent_temperature,0)}<small>°C</small></div>
          <div class="hero-stat-sub">H ${fmt(tMax,0)}° / L ${fmt(tMin,0)}°</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-label">Humidity</div>
          <div class="hero-stat-value">${fmt(cur.relative_humidity_2m,0)}<small>%</small></div>
          <div class="hero-stat-sub">Dew approx.</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-label">Pressure</div>
          <div class="hero-stat-value">${fmt(cur.surface_pressure,0)}<small>hPa</small></div>
          <div class="hero-stat-sub">Visibility ${cur.visibility?fmt(cur.visibility/1000,1):'–'}km</div>
        </div>
      </div>
    </div>
    <div class="hero-footer">
      ${sunrise ? `<span>🌅 <strong>${fmtTime(sunrise)}</strong></span><span class="dot">·</span>` : ''}
      ${sunset ? `<span>🌇 <strong>${fmtTime(sunset)}</strong></span><span class="dot">·</span>` : ''}
      <span>Cloud <strong>${fmt(cur.cloud_cover,0)}%</strong></span>
      <span class="dot">·</span>
      <span>Precip <strong>${fmt(cur.precipitation,1)}mm</strong></span>
    </div>
  `;
  // refresh chip
  document.getElementById('refresh-chip').textContent = `Updated ${new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}`;
  // trigger ocean viz
  initOcean(code, cur);
}

// ── Hourly ──
function renderHourly(hourly) {
  const target = document.getElementById('hourly');
  if (!hourly?.time?.length) { target.innerHTML = '<div class="empty">No hourly data</div>'; return; }
  const now = Date.now();
  const maxPrecip = Math.max(...(hourly.precipitation_probability||[0]), 1);
  target.innerHTML = hourly.time.slice(0,48).map((t,i) => {
    const dt = new Date(t);
    const isNow = Math.abs(dt - now) < 1800000;
    const precip = hourly.precipitation_probability?.[i] ?? 0;
    return `
    <div class="hour-cell${isNow?' now':''}">
      <div class="hour-time">${isNow?'Now':fmtHour(t)}</div>
      <div class="hour-icon">${wmoIcon(hourly.weather_code?.[i])}</div>
      <div class="hour-temp">${fmt(hourly.temperature_2m?.[i],0)}°</div>
      <div class="hour-precip">${precip>5?precip+'%':''}</div>
      <div class="hour-precip-bar"><span style="width:${precip}%"></span></div>
    </div>`;
  }).join('');
}

// ── Daily ──
function renderDaily(daily) {
  const target = document.getElementById('daily');
  if (!daily?.time?.length) { target.innerHTML = '<div class="empty">No daily data</div>'; return; }
  const allTemps = [...(daily.temperature_2m_min||[]), ...(daily.temperature_2m_max||[])].filter(v => v != null);
  const tmin = Math.min(...allTemps, 0);
  const tmax = Math.max(...allTemps, 1);
  const range = tmax - tmin || 1;
  target.innerHTML = daily.time.map((t,i) => {
    const lo = daily.temperature_2m_min?.[i];
    const hi = daily.temperature_2m_max?.[i];
    const loPct = ((lo - tmin) / range) * 100;
    const hiPct = ((hi - tmin) / range) * 100;
    return `
    <div class="day-row">
      <div class="day-name">${dayName(t)}<small>${dateFmt(t)}</small></div>
      <div class="day-icon">${wmoIcon(daily.weather_code?.[i])}</div>
      <div class="day-bar" style="--low:${loPct}%;--high:${hiPct}%"></div>
      <div class="day-temps"><span class="hi">${fmt(hi,0)}°</span><span class="lo">${fmt(lo,0)}°</span></div>
    </div>`;
  }).join('');
}

// ── Marine ──
function renderMarine(marine) {
  const cur = marine?.current ?? {};
  const target = document.getElementById('marine');
  target.innerHTML = `
    <div class="gauge">
      <div class="gauge-label">Wave Height</div>
      <div class="gauge-value">${fmt(cur.wave_height)}<small>m</small></div>
      <div class="gauge-sub">Sig wave</div>
    </div>
    <div class="gauge">
      <div class="gauge-label">Period</div>
      <div class="gauge-value">${fmt(cur.wave_period)}<small>s</small></div>
      <div class="gauge-sub">Between crests</div>
    </div>
    <div class="gauge">
      <div class="gauge-label">Sea Temp</div>
      <div class="gauge-value">${fmt(cur.sea_surface_temperature)}<small>°C</small></div>
      <div class="gauge-sub">Surface</div>
    </div>
    <div class="gauge">
      <div class="gauge-label">Wind Wave</div>
      <div class="gauge-value">${fmt(cur.wind_wave_height)}<small>m</small></div>
      <div class="gauge-sub">Local chop</div>
    </div>`;
}

function renderAQI(aq) {
  const cur = aq?.current ?? {};
  const aqi = cur.european_aqi;
  if (aqi == null) { document.getElementById('air-quality').innerHTML = ''; return; }
  let label = 'Good', color = 'var(--good)';
  if (aqi > 80) { label='Very Poor'; color='var(--bad)'; }
  else if (aqi > 60) { label='Poor'; color='var(--bad)'; }
  else if (aqi > 40) { label='Moderate'; color='var(--warn)'; }
  else if (aqi > 20) { label='Fair'; color='var(--good)'; }
  document.getElementById('air-quality').innerHTML = `
    <div style="padding-top:14px;border-top:1px solid var(--line);display:flex;gap:16px;align-items:center">
      <div>
        <div class="gauge-label">Air Quality</div>
        <div style="display:flex;align-items:baseline;gap:10px;margin-top:4px">
          <div style="font-size:28px;font-weight:700;font-variant-numeric:tabular-nums;color:${color}">${fmt(aqi,0)}</div>
          <div style="font-size:13px;font-weight:600;color:${color}">${label}</div>
        </div>
      </div>
      <div style="flex:1;display:flex;gap:12px;justify-content:flex-end">
        <div><div class="gauge-label">PM2.5</div><div style="font-weight:600">${fmt(cur.pm2_5)}</div></div>
        <div><div class="gauge-label">PM10</div><div style="font-weight:600">${fmt(cur.pm10)}</div></div>
        <div><div class="gauge-label">O₃</div><div style="font-weight:600">${fmt(cur.ozone)}</div></div>
      </div>
    </div>`;
}

// ── Weather fetch ──
async function loadWeather() {
  try {
    const res = await fetch(`/api/weather/${currentLoc}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    renderHero(data.location, data.forecast?.current ?? {}, data.forecast?.daily ?? {});
    renderHourly(data.forecast?.hourly);
    renderDaily(data.forecast?.daily);
    renderMarine(data.marine);
    renderAQI(data.air_quality);
  } catch(e) {
    document.getElementById('hero-content').innerHTML = `<div style="padding:20px;color:var(--bad)">⚠ Weather failed: ${e.message}</div>`;
  }
}

// ── Warnings ──
async function loadWarnings() {
  try {
    const res = await fetch('/api/warnings');
    const data = await res.json();
    const warns = data?.data?.warnings ?? data?.warnings ?? [];
    const el = document.getElementById('warnings');
    if (!warns.length) { el.innerHTML = ''; return; }
    const severest = warns[0];
    const sev = severest.level || severest.severity || 'yellow';
    el.innerHTML = `
      <div class="warn-strip">
        <span class="pill" style="background:${sev==='red'?'rgba(255,107,107,0.4)':sev==='amber'?'rgba(255,181,69,0.35)':'rgba(234,179,8,0.35)'}">${sev}</span>
        <span><strong>${severest.headline || severest.title || 'Weather warning'}</strong>${warns.length>1 ? ` · +${warns.length-1} more` : ''}</span>
      </div>`;
  } catch(e) { /* silent */ }
}

// ── Storm Tracker ──
function sevClass(s) { return ['severe','strong','moderate','brief'].includes(s) ? s : 'brief'; }
function renderStormTracker(data) {
  const active = data?.active_storm;
  const totals = data?.totals_14d || {};
  const episodes = data?.recent_episodes || [];

  const activeEl = document.getElementById('storm-active');
  if (active && active.active) {
    const cls = active.severity === 'severe' ? 'severe' : '';
    activeEl.innerHTML = `
      <div class="storm-banner ${cls}" onclick="window.openStormDetail(${JSON.stringify(active).replace(/"/g,'&quot;')})">
        <div>
          <div class="head">⛈️ Active Storm · ${active.severity}</div>
          <div class="headline">${active.headline || 'Storm in progress'}</div>
          <div class="meta">Since ${new Date(active.start_at).toLocaleString('en-GB',{weekday:'short',hour:'2-digit',minute:'2-digit'})} · ${active.duration_h?.toFixed(1) || '0.0'}h elapsed</div>
        </div>
        <div class="metrics">
          <div class="storm-metric"><div class="storm-metric-label">Peak Gust</div><div class="storm-metric-value">${fmt(active.peak_gust_kph,0)}kph</div></div>
          <div class="storm-metric"><div class="storm-metric-label">Min Pressure</div><div class="storm-metric-value">${fmt(active.min_pressure_hpa,0)}hPa</div></div>
          <div class="storm-metric"><div class="storm-metric-label">Rain</div><div class="storm-metric-value">${fmt(active.total_rain_mm,1)}mm</div></div>
        </div>
      </div>`;
  } else {
    activeEl.innerHTML = '';
  }

  document.getElementById('storm-totals').innerHTML = `
    <div class="storm-total"><div class="storm-total-label">Episodes</div><div class="storm-total-value">${totals.episode_count ?? 0}</div></div>
    <div class="storm-total"><div class="storm-total-label">Stormy hrs</div><div class="storm-total-value">${fmt(totals.stormy_hours,1)}</div></div>
    <div class="storm-total"><div class="storm-total-label">Total rain</div><div class="storm-total-value">${fmt(totals.total_rain_mm,1)}mm</div></div>
    <div class="storm-total"><div class="storm-total-label">Strongest wind</div><div class="storm-total-value">${fmt(totals.strongest_wind_kph,0)}kph</div></div>
    <div class="storm-total"><div class="storm-total-label">Lowest pressure</div><div class="storm-total-value">${fmt(totals.lowest_pressure_hpa,0)}</div></div>`;

  const epEl = document.getElementById('storm-episodes');
  if (!episodes.length && !(active && active.active)) {
    epEl.innerHTML = '<div class="empty">No storm episodes in the last 14 days</div>';
  } else if (!episodes.length) {
    epEl.innerHTML = '';
  } else {
    epEl.innerHTML = episodes.slice(0,8).map(ep => `
      <div class="storm-episode" data-ep='${JSON.stringify(ep).replace(/'/g,"&#39;")}'>
        <div>
          <div class="ep-time">${new Date(ep.start_at).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'})} · ${ep.duration_h?.toFixed(1)||'0'}h</div>
