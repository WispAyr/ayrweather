// ── Radar ──
let radarMap=null, radarLayer=null, radarTimestamps=[], radarIdx=0, radarPlaying=true, radarInt=null;
async function initRadar() {
  if (radarMap) return;
  radarMap = L.map('radar-map', {zoomControl:true, attributionControl:false}).setView([55.5, -4.6], 9);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    subdomains: 'abcd', maxZoom: 19, attribution: '© OSM · CARTO'
  }).addTo(radarMap);
  L.circle([55.4583,-4.6292], {radius: 500, color: '#ffb545', weight: 2, fillOpacity: 0.3}).addTo(radarMap).bindPopup('Ayr');
  await loadRadarFrames();
  if (radarPlaying) startRadarAnim();
  document.getElementById('radar-play').addEventListener('click', toggleRadar);
  document.getElementById('radar-slider').addEventListener('input', e => { radarIdx = parseInt(e.target.value); showRadarFrame(); });
}
async function loadRadarFrames() {
  try {
    const r = await fetch('https://api.rainviewer.com/public/weather-maps.json');
    const d = await r.json();
    radarTimestamps = [...(d.radar?.past||[]), ...(d.radar?.nowcast||[])];
    document.getElementById('radar-slider').max = radarTimestamps.length - 1;
    radarIdx = (d.radar?.past?.length || 1) - 1;
    showRadarFrame();
  } catch(e) { document.getElementById('radar-time').textContent = 'Radar unavailable'; }
}
function showRadarFrame() {
  const f = radarTimestamps[radarIdx]; if (!f) return;
  if (radarLayer) radarMap.removeLayer(radarLayer);
  radarLayer = L.tileLayer(`https://tilecache.rainviewer.com${f.path}/256/{z}/{x}/{y}/2/1_1.png`, { opacity: 0.7 }).addTo(radarMap);
  document.getElementById('radar-time').textContent = new Date(f.time * 1000).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
  document.getElementById('radar-slider').value = radarIdx;
}
function startRadarAnim() {
  if (radarInt) clearInterval(radarInt);
  radarInt = setInterval(() => { radarIdx = (radarIdx + 1) % radarTimestamps.length; showRadarFrame(); }, 700);
}
function toggleRadar() {
  radarPlaying = !radarPlaying;
  document.getElementById('radar-play').textContent = radarPlaying ? '⏸' : '▶';
  if (radarPlaying) startRadarAnim(); else if (radarInt) { clearInterval(radarInt); radarInt = null; }
}

// ── Three.js ocean hero ──
let oceanScene=null, oceanRenderer=null, oceanMesh=null, oceanRaf=null;
async function initOcean(code, cur) {
  const host = document.getElementById('hero-canvas');
  if (!host) return;
  try {
    const THREE = await import('three');
    if (oceanRaf) cancelAnimationFrame(oceanRaf);
    host.innerHTML = '';
    const w = host.clientWidth, h = host.clientHeight;
    oceanScene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(55, w/h, 0.1, 1000);
    cam.position.set(0, 12, 28); cam.lookAt(0, 0, 0);
    oceanRenderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
    oceanRenderer.setSize(w, h); oceanRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    host.appendChild(oceanRenderer.domElement);

    const geom = new THREE.PlaneGeometry(60, 40, 80, 60);
    const mood = moodFor(code);
    const waveAmp = (cur?.wind_speed_10m || 10) / 40;
    const mat = new THREE.ShaderMaterial({
      uniforms: {
        uTime: {value: 0},
        uColor1: {value: new THREE.Color(mood.m2)},
        uColor2: {value: new THREE.Color(mood.m3)},
        uAmp: {value: Math.min(0.8, 0.2 + waveAmp)},
      },
      vertexShader: `
        uniform float uTime; uniform float uAmp;
        varying float vH;
        void main(){
          vec3 p = position;
          float d = sin(p.x*0.3 + uTime*0.8) * cos(p.y*0.2 + uTime*0.6) * uAmp;
          d += sin(p.x*0.8 + uTime*1.4) * 0.15 * uAmp;
          p.z += d; vH = d;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(p,1.0);
        }`,
      fragmentShader: `
        uniform vec3 uColor1; uniform vec3 uColor2;
        varying float vH;
        void main(){
          float t = smoothstep(-0.5, 0.8, vH);
          vec3 c = mix(uColor1, uColor2, t);
          gl_FragColor = vec4(c, 0.85);
        }`,
      transparent: true,
    });
    oceanMesh = new THREE.Mesh(geom, mat); oceanMesh.rotation.x = -Math.PI/2.4; oceanScene.add(oceanMesh);
    const t0 = performance.now();
    const loop = () => {
      mat.uniforms.uTime.value = (performance.now() - t0) * 0.001;
      oceanRenderer.render(oceanScene, cam);
      oceanRaf = requestAnimationFrame(loop);
    };
    loop();
    window.addEventListener('resize', () => {
      if (!oceanRenderer) return;
      const w2 = host.clientWidth, h2 = host.clientHeight;
      oceanRenderer.setSize(w2, h2); cam.aspect = w2/h2; cam.updateProjectionMatrix();
    }, {passive:true});
  } catch(e) { /* silent */ }
}

