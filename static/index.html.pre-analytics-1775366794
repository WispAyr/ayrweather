async function loadPrism() {
  try {
    const [beaufort, risk, pressure, fog, sar, waves, storm, airquality, rain, aurora, tide] = await Promise.all([
      fetch(`${PRISM_BASE}/beaufort/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/maritime-risk/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/pressure-tendency/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/dew-point/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/sar-difficulty/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/wave-analysis`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/storm-forecast/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/air-quality/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/rain-nowcast/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/aurora-viewing/${currentLoc}`).then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(`${PRISM_BASE}/tidal-state`).then(r=>r.ok?r.json():null).catch(()=>null),
    ]);
    window.__prism = {
      beaufort: beaufort?.data, risk: risk?.data, pressure: pressure?.data,
      fog: fog?.data, sar: sar?.data, waves: waves?.data, storm: storm?.data, airquality: airquality?.data,
      rain: rain?.data, aurora: aurora?.data, tide: tide?.data,
    };
    const atm = [];
    const mar = [];

    if (storm?.data) {
      const d = storm.data;
      if (d.in_storm) atm.push(prismCard('⛈️ Storm', d.label, `Trajectory: ${d.trajectory?.replace(/_/g,' ')}`, d.ending_at?`Eases ${new Date(d.ending_at).toLocaleString('en-GB',{weekday:'short',hour:'2-digit',minute:'2-digit'})}`:'', d.trajectory==='intensifying'?'bad':'storm', "openPrismDetail('storm')"));
      else if (d.storm_approaching) atm.push(prismCard('⛈️ Incoming', d.label, 'Storm approaching', d.onset_time?`Expected ${new Date(d.onset_time).toLocaleString('en-GB',{weekday:'short',hour:'2-digit',minute:'2-digit'})}`:'', 'warn', "openPrismDetail('storm')"));
    }
    if (pressure?.data) {
      const d = pressure.data;
      atm.push(prismCard('📊 Pressure', `${d.arrow} ${d.current_hpa} hPa`, d.descriptor, `${d.rate_hpa_3h>0?'+':''}${d.rate_hpa_3h} hPa/3h`, d.storm_signal?'storm':'', "openPrismDetail('pressure')"));
    }
    if (rain?.data) {
      const d = rain.data;
      const mood = d.is_raining_now ? 'warn' : (d.hours_until_rain !== null && d.hours_until_rain < 2) ? 'warn' : '';
      const strip = (d.outlook_6h || []).map(h => h.raining ? '💧' : '·').join('');
      atm.push(prismCard('☔ Rain', d.label, strip ? `6h: ${strip}` : '', d.is_raining_now ? `${d.current_precip_mm} mm/h now` : '', mood, "openPrismDetail('rain')"));
    }
    if (fog?.data) {
      const d = fog.data;
      const mood = d.fog_risk==='high'?'bad':d.fog_risk==='moderate'?'warn':'good';
      atm.push(prismCard('🌫️ Fog', d.fog_risk, `Dew ${d.dew_point_c}°C · Spread ${d.spread_c}°C`, `Cloud base ${d.estimated_cloud_base_m}m`, mood, "openPrismDetail('fog')"));
    }
    if (airquality?.data) {
      const d = airquality.data;
      const aqi = d.european_aqi;
      const mood = aqi>80?'bad':aqi>60?'warn':aqi>40?'':'good';
      const cls = mood ? `mood-${mood}` : '';
      const topPollutants = Object.values(d.pollutants || {}).sort((a,b) => b.who_ratio - a.who_ratio);
      const pollutantChips = topPollutants.slice(0,5).map(p => {
        const barColor = p.who_ratio<0.5?'#22c55e':p.who_ratio<1?'#84cc16':p.who_ratio<2?'#eab308':'#ef4444';
        const barWidth = Math.min(100, p.who_ratio * 100);
        return `<div style="flex:1;min-width:90px">
          <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-mute);text-transform:uppercase;letter-spacing:0.5px;font-weight:600"><span>${p.name}</span><span>${(p.who_ratio*100).toFixed(0)}%</span></div>
          <div style="font-size:14px;font-weight:700;margin-top:2px;font-variant-numeric:tabular-nums">${p.value}<span style="font-size:10px;color:var(--text-mute);margin-left:2px">μg/m³</span></div>
          <div style="background:var(--surface-2);height:3px;border-radius:2px;margin-top:4px;overflow:hidden"><div style="height:100%;width:${barWidth}%;background:${barColor}"></div></div>
        </div>`;
      }).join('');

      // Plain-English one-liner
      let plainSummary = '';
      if (aqi == null) plainSummary = 'Data unavailable';
      else if (aqi < 20) plainSummary = 'Really clean — go enjoy being outside';
      else if (aqi < 40) plainSummary = 'Normal healthy air — all outdoor activity fine';
      else if (aqi < 60) plainSummary = 'OK but not pristine — sensitive folk ease off hard exercise';
      else if (aqi < 80) plainSummary = 'Noticeably poor — kids, elderly, asthma should take it easy';
      else if (aqi < 100) plainSummary = 'Bad air — cut outdoor exercise, keep windows shut';
      else plainSummary = 'Severe — stay inside, close windows';

      atm.push(`<div class="prism-card ${cls}" onclick="openPrismDetail('airquality')" style="grid-column: span 2">
        <div class="prism-label">💨 Air Quality</div>
        <div style="display:flex;align-items:baseline;gap:10px;margin-top:6px">
          <div class="prism-value">AQI ${aqi}</div>
          <div style="font-size:13px;color:var(--text-dim);font-weight:600;padding:2px 10px;border-radius:100px;background:${d.band?.color || 'var(--surface-2)'}22;color:${d.band?.color || 'var(--text-dim)'}">${d.band?.label || ''}</div>
        </div>
        <div style="font-size:13px;color:var(--text-dim);margin-top:6px;font-weight:500">${plainSummary}</div>
        <div style="display:flex;gap:12px;margin-top:12px;flex-wrap:wrap">${pollutantChips}</div>
        ${d.dominant_pollutant ? `<div class="prism-meta" style="margin-top:10px">Mainly from ${d.dominant_pollutant.name} — sources: ${d.dominant_pollutant.sources?.slice(0,2).join(', ').toLowerCase() || ''}</div>` : ''}
        <div class="prism-meta" style="margin-top:6px;color:var(--text-mute)">Tap for full explanation →</div>
      </div>`);
    }
    if (aurora?.data && aurora.data.score >= 25) {
      const d = aurora.data;
      const mood = d.score >= 75 ? 'good' : d.score >= 55 ? '' : 'warn';
      atm.push(prismCard('🌌 Aurora', d.chance, `${d.score}/100 · Kp ${d.kp_now}`, d.advice, mood, "openPrismDetail('aurora')"));
    }

    if (risk?.data) {
      const d = risk.data;
      const mood = d.risk_level==='extreme'||d.risk_level==='high'?'bad':d.risk_level==='moderate'?'warn':'good';
      mar.push(prismCard('⚓ Maritime Risk', `${d.score}/10`, d.risk_level, d.recommendation || '', mood, "openPrismDetail('risk')"));
    }
    if (beaufort?.data) {
      const d = beaufort.data;
      mar.push(prismCard('💨 Beaufort', `F${d.beaufort_number}`, d.description, d.sea_state, d.beaufort_number>=8?'bad':d.beaufort_number>=6?'warn':'', "openPrismDetail('beaufort')"));
    }
    if (waves?.data) {
      const d = waves.data;
      const mood = d.breaking_risk === 'high' ? 'warn' : '';
      mar.push(prismCard('🌊 Waves', `${d.wave_height_m}m / ${d.wave_period_s}s`, d.sea_type, `Breaking: ${d.breaking_risk}`, mood, "openPrismDetail('waves')"));
    }
    if (tide?.data) {
      const d = tide.data;
      mar.push(prismCard('🌊 Tide', `${d.arrow} ${d.current_height_m != null ? d.current_height_m + 'm' : '—'}`, d.phase, d.next_event ? `Next ${d.next_event.type} in ${d.next_event.hours_until}h` : '', '', "openPrismDetail('tide')"));
    }
    if (sar?.data) {
      const d = sar.data;
      const mood = d.difficulty >= 7 ? 'bad' : d.difficulty >= 4 ? 'warn' : 'good';
      mar.push(prismCard('🚁 SAR', `${d.difficulty}/10`, d.assessment || '', d.is_dark ? '🌙 Night ops' : `${d.daylight_remaining_h}h daylight`, mood, "openPrismDetail('sar')"));
    }

    document.getElementById('prism-atmosphere').innerHTML = atm.length ? `<div class="section-sub" style="margin-bottom:8px">Atmosphere</div><div class="prism-grid">${atm.join('')}</div>` : '';
    document.getElementById('prism-maritime').innerHTML = mar.length ? `<div class="section-sub" style="margin-bottom:8px">Maritime</div><div class="prism-grid">${mar.join('')}</div>` : '';
  } catch(e) { /* silent */ }
}

// ── Rivers ──
async function loadRivers() {
  try {
    const res = await fetch('/api/rivers');
    const data = await res.json();
    const rivers = data?.rivers || {};
    const keys = Object.keys(rivers);
    const target = document.getElementById('rivers');
    if (!keys.length) { target.innerHTML = '<div class="empty">No river data</div>'; return; }
    target.innerHTML = keys.map(k => {
      const r = rivers[k];
      const level = r.current?.level_m;
      const trend = r.trend;
      const arrow = trend==='rising'?'↑':trend==='falling'?'↓':'→';
      const color = trend==='rising'?'var(--warn)':trend==='falling'?'var(--info)':'var(--good)';
      const name = (r.station || k.replace(/_/g,' ').replace(/river /i,'')).replace(/\b\w/g, c => c.toUpperCase());
      return `<div class="river-row">
        <div class="river-name">${name}<small>24h: ${fmt(r.min_24h,2)} – ${fmt(r.max_24h,2)}m</small></div>
        <div class="river-trend" style="color:${color}">${arrow}</div>
        <div class="river-level">${fmt(level,2)}<small>m</small></div>
      </div>`;
    }).join('');
  } catch(e) { document.getElementById('rivers').innerHTML = '<div class="empty">Rivers unavailable</div>'; }
}

// ── Sky block ──
async function loadSky() {
  const [moon, aurora, uv] = await Promise.all([
    fetch('/api/moon').then(r=>r.ok?r.json():null).catch(()=>null),
    fetch('/api/aurora').then(r=>r.ok?r.json():null).catch(()=>null),
    fetch('/api/uv').then(r=>r.ok?r.json():null).catch(()=>null),
  ]);
  const el = document.getElementById('sky');
  const blocks = [];
  if (moon) blocks.push(`<div class="sky-block"><h4>🌙 Moon</h4><div class="sky-big">${moon.emoji||''} ${moon.illumination??'–'}%</div><div class="sky-sub">${moon.phase_name||'Unknown'}</div></div>`);
  if (aurora) {
    const kp = aurora.kp_index ?? aurora.kp;
    blocks.push(`<div class="sky-block"><h4>🌌 Aurora</h4><div class="sky-big">Kp ${fmt(kp,1)}</div><div class="sky-sub">${aurora.activity||aurora.level||'Quiet'}</div></div>`);
  }
  if (uv) {
    const v = uv.uv_index ?? uv.current?.uv_index;
    blocks.push(`<div class="sky-block"><h4>☀️ UV</h4><div class="sky-big">${fmt(v,1)}</div><div class="sky-sub">${uv.category||'—'}</div></div>`);
  }
  blocks.push(`<div class="sky-block"><h4>🛰️ ISS</h4><div class="sky-big" id="iss-coord">—</div><div class="sky-sub" id="iss-upd">Fetching…</div></div>`);
  el.innerHTML = blocks.join('');
  updateISS();
  if (window.__issInt) clearInterval(window.__issInt);
  window.__issInt = setInterval(updateISS, 30000);
}
async function updateISS() {
  try {
    const r = await fetch('/api/iss'); if (!r.ok) return;
    const d = await r.json();
    const c = document.getElementById('iss-coord');
    const u = document.getElementById('iss-upd');
    if (c) c.textContent = `${fmt(d.latitude,2)}° / ${fmt(d.longitude,2)}°`;
    if (u) u.textContent = 'Updated ' + new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  } catch {}
}

// ── Extras ──
async function loadExtras() {
  const [fuel, fx, aviation, space, floods] = await Promise.all([
    fetch('/api/fuel').then(r=>r.ok?r.json():null).catch(()=>null),
    fetch('/api/finance/fx').then(r=>r.ok?r.json():null).catch(()=>null),
    fetch('/api/aviation').then(r=>r.ok?r.json():null).catch(()=>null),
    fetch('/api/space').then(r=>r.ok?r.json():null).catch(()=>null),
    fetch('/api/floods').then(r=>r.ok?r.json():null).catch(()=>null),
  ]);
  const extras = [];
  if (fuel) {
    const petrol = fuel?.data?.petrol_avg ?? fuel?.petrol_avg ?? fuel?.uk_avg?.petrol;
    const diesel = fuel?.data?.diesel_avg ?? fuel?.diesel_avg ?? fuel?.uk_avg?.diesel;
    if (petrol || diesel) extras.push(`<div class="card"><div class="gauge-label">⛽ Fuel (p/L)</div><div style="display:flex;gap:16px;margin-top:6px"><div><div class="gauge-value">${fmt(petrol,1)}</div><div class="gauge-sub">Petrol</div></div><div><div class="gauge-value">${fmt(diesel,1)}</div><div class="gauge-sub">Diesel</div></div></div></div>`);
  }
  if (fx?.rates) {
    const r = fx.rates;
    extras.push(`<div class="card"><div class="gauge-label">💱 FX (GBP)</div><div style="display:flex;gap:14px;margin-top:6px;flex-wrap:wrap"><div><div class="gauge-value">${fmt(r.USD,3)}</div><div class="gauge-sub">USD</div></div><div><div class="gauge-value">${fmt(r.EUR,3)}</div><div class="gauge-sub">EUR</div></div></div></div>`);
  }
  const flightCount = aviation?.data?.count ?? aviation?.flights?.length ?? aviation?.count;
  if (flightCount != null) extras.push(`<div class="card"><div class="gauge-label">✈️ Aviation</div><div class="gauge-value" style="margin-top:6px">${flightCount}</div><div class="gauge-sub">Tracked flights</div></div>`);
  const satCount = space?.data?.count ?? space?.count;
  if (satCount != null) extras.push(`<div class="card"><div class="gauge-label">🛰️ Satellites</div><div class="gauge-value" style="margin-top:6px">${satCount}</div><div class="gauge-sub">Overhead/tracked</div></div>`);
  const floodCount = floods?.warnings?.length ?? floods?.data?.warnings?.length ?? 0;
  if (floodCount) extras.push(`<div class="card" style="border-color:rgba(255,107,107,0.38)"><div class="gauge-label">🌊 Flood Warnings</div><div class="gauge-value" style="color:var(--bad);margin-top:6px">${floodCount}</div><div class="gauge-sub">Active (SEPA)</div></div>`);

  document.getElementById('extras').innerHTML = extras.join('');
}

