/* ──────────────────────────────────────────────────────────
   AyrWeather · Redesign 2026
   A modern, airy Ayrshire weather dashboard.
   Dark-first, responsive, chromeless.
   ────────────────────────────────────────────────────────── */

:root {
  /* Mood palette — replaced dynamically based on weather code */
  --mood-1: #0b1220;
  --mood-2: #13203a;
  --mood-3: #1c2f55;
  --accent: #6ea8ff;
  --accent-soft: rgba(110,168,255,0.15);

  /* Neutrals (dark) */
  --bg: #07101e;
  --surface: rgba(255,255,255,0.04);
  --surface-2: rgba(255,255,255,0.07);
  --surface-hi: rgba(255,255,255,0.10);
  --line: rgba(255,255,255,0.08);
  --line-2: rgba(255,255,255,0.14);
  --text: #eaf1fb;
  --text-dim: rgba(234,241,251,0.68);
  --text-mute: rgba(234,241,251,0.45);

  /* Semantic */
  --good: #32d296;
  --warn: #ffb545;
  --bad:  #ff6b6b;
  --info: #6ea8ff;
  --storm: #b48bff;

  /* Radius & motion */
  --r-xs: 8px;
  --r-sm: 12px;
  --r-md: 18px;
  --r-lg: 26px;
  --r-xl: 34px;
  --ease: cubic-bezier(.4,0,.2,1);
  --t-fast: 180ms;
  --t-med: 360ms;
  --t-slow: 700ms;
}

html[data-theme="light"] {
  --bg: #f4f7fc;
  --surface: rgba(12,28,58,0.04);
  --surface-2: rgba(12,28,58,0.07);
  --surface-hi: rgba(12,28,58,0.10);
  --line: rgba(12,28,58,0.08);
  --line-2: rgba(12,28,58,0.16);
  --text: #0b1f3a;
  --text-dim: rgba(11,31,58,0.72);
  --text-mute: rgba(11,31,58,0.50);
}

* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, system-ui, sans-serif;
  font-feature-settings: "ss01", "cv11";
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.005em;
  transition: background var(--t-slow) var(--ease), color var(--t-med) var(--ease);
}

body {
  min-height: 100vh;
  background:
    radial-gradient(1200px 600px at 10% -10%, var(--mood-3) 0%, transparent 55%),
    radial-gradient(900px 500px at 90% 0%, var(--mood-2) 0%, transparent 60%),
    var(--bg);
  background-attachment: fixed;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ── Layout ── */
.shell { max-width: 1240px; margin: 0 auto; padding: 20px 24px 96px; }

.topbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; margin-bottom: 18px;
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; letter-spacing: 0.02em; }
.brand-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 18px var(--accent);
  animation: pulse 2.4s var(--ease) infinite;
}
@keyframes pulse {
  0%,100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.35); opacity: 0.6; }
}
.brand small { color: var(--text-mute); font-weight: 500; margin-left: 6px; font-size: 12px; }
.topbar-right { display: flex; align-items: center; gap: 10px; }
.chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--text-dim);
  font-size: 12px; font-weight: 500;
  cursor: pointer;
  transition: all var(--t-fast) var(--ease);
}
.chip:hover { background: var(--surface-2); color: var(--text); }
.chip.icon { padding: 6px 10px; }

/* ── Location selector ── */
.locbar {
  display: flex; gap: 6px; overflow-x: auto;
  padding: 4px 0 12px; margin-bottom: 14px;
  scrollbar-width: none;
}
.locbar::-webkit-scrollbar { display: none; }
.loc-pill {
  flex: 0 0 auto;
  font-family: inherit; font-size: 13px; font-weight: 500;
  padding: 8px 16px; border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--text-dim);
  cursor: pointer;
  transition: all var(--t-fast) var(--ease);
  white-space: nowrap;
}
.loc-pill:hover { border-color: var(--line-2); color: var(--text); }
.loc-pill.active {
  background: var(--text);
  color: var(--bg);
  border-color: var(--text);
  font-weight: 600;
}

/* ── Hero ── */
.hero {
  position: relative;
  border-radius: var(--r-xl);
  padding: 40px 36px 32px;
  margin-bottom: 28px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%),
    linear-gradient(135deg, var(--mood-2) 0%, var(--mood-1) 100%);
  border: 1px solid var(--line);
  isolation: isolate;
  min-height: 340px;
}
.hero-canvas { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.9; }
.hero-canvas canvas { width: 100% !important; height: 100% !important; display: block; }
.hero::after {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 70% 20%, transparent 0%, rgba(7,16,30,0.55) 100%);
  z-index: 1; pointer-events: none;
}
.hero-content { position: relative; z-index: 2; }

.hero-head {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 12px;
  font-size: 12px; color: var(--text-dim); font-weight: 500;
  letter-spacing: 0.04em; text-transform: uppercase;
}
.hero-head .live {
  display: inline-flex; align-items: center; gap: 6px;
}
.hero-head .live::before {
  content: ""; width: 6px; height: 6px; border-radius: 50%;
  background: var(--good);
  box-shadow: 0 0 10px var(--good);
  animation: pulse 2s var(--ease) infinite;
}

.hero-city {
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 800;
  letter-spacing: -0.025em;
  margin: 18px 0 4px;
  line-height: 1;
}
.hero-desc {
  font-size: 17px; color: var(--text-dim); font-weight: 500;
  margin-bottom: 24px;
}
.hero-row {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 32px; flex-wrap: wrap;
}
.hero-temp {
  font-size: clamp(96px, 14vw, 164px);
  font-weight: 200;
  letter-spacing: -0.04em;
  line-height: 0.85;
  font-variant-numeric: tabular-nums;
  background: linear-gradient(180deg, var(--text) 0%, rgba(234,241,251,0.55) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: flex; align-items: flex-start; gap: 8px;
}
.hero-temp .unit { font-size: 0.3em; font-weight: 400; color: var(--text-dim); margin-top: 0.2em; }
.hero-temp .icon { font-size: 0.5em; margin-left: 8px; line-height: 1; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.3)); }

.hero-summary {
  flex: 1 1 260px; max-width: 420px;
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.hero-stat {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--line);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: var(--r-md);
  padding: 14px 16px;
}
.hero-stat-label {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--text-mute); font-weight: 600;
}
.hero-stat-value {
  font-size: 22px; font-weight: 600; margin-top: 4px;
  font-variant-numeric: tabular-nums;
}
.hero-stat-value small { font-size: 12px; font-weight: 400; color: var(--text-dim); margin-left: 3px; }
.hero-stat-sub { font-size: 11px; color: var(--text-mute); margin-top: 2px; }

.hero-footer {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-top: 26px; padding-top: 20px;
  border-top: 1px solid var(--line);
  font-size: 12.5px; color: var(--text-dim);
}
.hero-footer .dot { opacity: 0.4; margin: 0 2px; }
.hero-footer strong { color: var(--text); font-weight: 600; }

/* ── Warning strip ── */
.warn-strip {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 16px;
  border-radius: var(--r-md);
  background: linear-gradient(90deg, rgba(255,107,107,0.18), rgba(180,139,255,0.18));
  border: 1px solid rgba(255,107,107,0.32);
  margin-bottom: 20px;
  font-size: 13.5px; color: var(--text);
  font-weight: 500;
}
.warn-strip .pill { padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }

/* ── Section primitives ── */
.section { margin-bottom: 26px; }
.section-head {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 10px; margin-bottom: 14px;
}
.section-title {
  font-size: 13px; font-weight: 700;
  color: var(--text); letter-spacing: 0.02em;
  text-transform: uppercase;
}
.section-sub { font-size: 12px; color: var(--text-mute); }

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: 22px;
  transition: all var(--t-fast) var(--ease);
}
.card.interactive { cursor: pointer; }
.card.interactive:hover { background: var(--surface-2); border-color: var(--line-2); transform: translateY(-1px); }

.grid { display: grid; gap: 16px; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
@media (max-width: 860px) { .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; } }

/* ── Hourly strip ── */
.hourly {
  display: flex; gap: 8px; overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 4px 2px 14px;
  scrollbar-width: thin;
  scrollbar-color: var(--line-2) transparent;
}
.hourly::-webkit-scrollbar { height: 6px; }
.hourly::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 3px; }
.hour-cell {
  flex: 0 0 auto; scroll-snap-align: start;
  width: 72px; padding: 14px 8px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px solid transparent;
  text-align: center;
  transition: all var(--t-fast) var(--ease);
}
.hour-cell.now {
  background: var(--accent-soft);
  border-color: var(--accent);
}
.hour-cell:hover { background: var(--surface-2); }
.hour-time { font-size: 11px; color: var(--text-mute); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
.hour-icon { font-size: 24px; margin: 8px 0 4px; }
.hour-temp { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
.hour-precip { font-size: 10.5px; color: var(--info); margin-top: 6px; font-weight: 600; height: 14px; }
.hour-precip-bar { height: 3px; border-radius: 2px; background: var(--line); margin-top: 4px; position: relative; overflow: hidden; }
.hour-precip-bar span { position: absolute; left: 0; top: 0; bottom: 0; background: var(--info); border-radius: 2px; }

/* ── Daily forecast ── */
.daily-list { display: flex; flex-direction: column; gap: 2px; }
.day-row {
  display: grid;
  grid-template-columns: 92px 40px 1fr auto;
  gap: 16px; align-items: center;
  padding: 12px 4px;
  border-bottom: 1px solid var(--line);
}
.day-row:last-child { border-bottom: none; }
.day-name { font-weight: 600; font-size: 14px; }
.day-name small { display: block; font-size: 11px; color: var(--text-mute); font-weight: 500; margin-top: 1px; }
.day-icon { font-size: 22px; text-align: center; }
.day-bar {
  position: relative; height: 6px;
  background: linear-gradient(90deg, rgba(110,168,255,0.2), rgba(255,181,69,0.3));
  border-radius: 3px;
}
.day-bar::before, .day-bar::after {
  content: ""; position: absolute; top: -3px; width: 12px; height: 12px;
  border-radius: 50%; border: 2px solid var(--bg);
}
.day-bar::before { background: var(--info); left: var(--low, 0%); transform: translateX(-50%); }
.day-bar::after { background: var(--warn); right: calc(100% - var(--high, 100%)); transform: translateX(50%); }
.day-temps {
  font-variant-numeric: tabular-nums; font-weight: 600;
  display: flex; gap: 10px; min-width: 80px; justify-content: flex-end;
}
.day-temps .hi { color: var(--text); }
.day-temps .lo { color: var(--text-mute); }

/* ── Marine / sea card ── */
.marine-gauges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 10px; }
.gauge {
  display: flex; flex-direction: column; gap: 4px;
  padding: 14px 16px; border-radius: var(--r-md);
  background: var(--surface-2);
}
.gauge-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-mute); font-weight: 600; }
.gauge-value { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
.gauge-value small { font-size: 12px; font-weight: 400; color: var(--text-dim); margin-left: 2px; }
.gauge-sub { font-size: 11px; color: var(--text-mute); }
@media (max-width: 640px) { .marine-gauges { grid-template-columns: 1fr 1fr; } }

/* ── Prism intelligence cards ── */
.prism-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
.prism-card {
  position: relative;
  padding: 16px;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1px solid var(--line);
  cursor: pointer;
  transition: all var(--t-fast) var(--ease);
  overflow: hidden;
}
.prism-card::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px; background: var(--accent);
}
.prism-card:hover { background: var(--surface-2); border-color: var(--line-2); transform: translateY(-1px); }
.prism-card.mood-warn::before { background: var(--warn); }
.prism-card.mood-bad::before { background: var(--bad); }
.prism-card.mood-good::before { background: var(--good); }
.prism-card.mood-storm::before { background: var(--storm); }
.prism-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-mute); font-weight: 600; }
.prism-value { font-size: 20px; font-weight: 700; margin-top: 6px; }
.prism-sub { font-size: 12px; color: var(--text-dim); margin-top: 4px; }
.prism-meta { font-size: 11px; color: var(--text-mute); margin-top: 6px; }

/* ── Storm log ── */
.storm-banner {
  padding: 20px 24px; border-radius: var(--r-lg);
  background: linear-gradient(135deg, rgba(180,139,255,0.20), rgba(110,168,255,0.12));
  border: 1px solid rgba(180,139,255,0.35);
  display: grid; grid-template-columns: 1fr auto; gap: 20px;
  align-items: center;
}
.storm-banner.severe { background: linear-gradient(135deg, rgba(255,107,107,0.22), rgba(180,139,255,0.15)); border-color: rgba(255,107,107,0.38); }
.storm-banner .head { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-mute); font-weight: 700; margin-bottom: 6px; display:flex; align-items:center; gap:8px; }
.storm-banner .headline { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; }
.storm-banner .meta { font-size: 12px; color: var(--text-dim); margin-top: 4px; }
.storm-banner .metrics { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-end; }
.storm-metric { text-align: right; }
.storm-metric-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-mute); font-weight: 600; }
.storm-metric-value { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
@media (max-width: 720px) { .storm-banner { grid-template-columns: 1fr; } .storm-banner .metrics { justify-content: flex-start; } .storm-metric { text-align: left; } }

.storm-totals {
  display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px;
  border-radius: var(--r-md); overflow: hidden; background: var(--line);
}
.storm-total { background: var(--surface); padding: 14px; }
.storm-total-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-mute); font-weight: 600; }
.storm-total-value { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 4px; }
@media (max-width: 720px) { .storm-totals { grid-template-columns: repeat(2, 1fr); } }

.storm-episode {
  padding: 14px 16px; border-radius: var(--r-md);
  background: var(--surface); border: 1px solid var(--line);
  display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center;
  cursor: pointer; transition: all var(--t-fast) var(--ease);
}
.storm-episode:hover { background: var(--surface-2); }
.storm-episode .ep-time { font-size: 11px; color: var(--text-mute); font-weight: 600; letter-spacing: 0.02em; }
.storm-episode .ep-head { font-size: 14px; font-weight: 600; margin-top: 2px; }
.storm-episode .sev {
  display: inline-flex; padding: 3px 10px; border-radius: 999px;
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  background: var(--surface-hi); color: var(--text-dim);
}
.storm-episode .sev.severe { background: rgba(255,107,107,0.22); color: #ffb5b5; }
.storm-episode .sev.strong { background: rgba(255,181,69,0.22); color: #ffcf8a; }
.storm-episode .sev.moderate { background: rgba(110,168,255,0.22); color: #a5c5ff; }
.storm-episode .sev.brief { background: rgba(180,139,255,0.22); color: #d0b8ff; }

/* ── River table ── */
.rivers { display: flex; flex-direction: column; gap: 1px; }
.river-row {
  display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: center;
  padding: 12px 4px; border-bottom: 1px solid var(--line);
}
.river-row:last-child { border-bottom: none; }
.river-name { font-weight: 500; font-size: 13.5px; }
.river-name small { display: block; color: var(--text-mute); font-size: 11px; margin-top: 1px; }
.river-level { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; min-width: 72px; text-align: right; }
.river-level small { font-size: 11px; font-weight: 400; color: var(--text-dim); margin-left: 2px; }
.river-trend { font-size: 16px; width: 24px; text-align: center; }

/* ── Radar map ── */
.radar-wrap {
  border-radius: var(--r-lg); overflow: hidden; position: relative;
  height: 420px; border: 1px solid var(--line);
}
.radar-wrap #radar-map { width: 100%; height: 100%; background: #061120; }
.radar-controls {
  position: absolute; left: 16px; bottom: 16px; right: 16px; z-index: 400;
  display: flex; align-items: center; gap: 12px;
  padding: 10px 14px;
  background: rgba(6,17,32,0.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  color: var(--text);
  font-size: 12px;
}
.radar-controls button { background: transparent; border: none; color: var(--text); cursor: pointer; font-size: 14px; padding: 4px 8px; }
.radar-time { flex: 1; font-variant-numeric: tabular-nums; font-weight: 600; }
.radar-slider { flex: 2; }

/* ── Sky / extras ── */
.sky-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
@media (max-width: 520px) { .sky-grid { grid-template-columns: 1fr; } }
.sky-block {
  padding: 16px; border-radius: var(--r-md);
  background: var(--surface-2);
}
.sky-block h4 { margin: 0 0 10px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-mute); font-weight: 700; }
.sky-big { font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; }
.sky-sub { font-size: 12px; color: var(--text-dim); margin-top: 2px; }

/* ── Drawer (detail panel) ── */
.drawer-backdrop {
  position: fixed; inset: 0; background: rgba(0,0,0,0.5);
  opacity: 0; pointer-events: none; transition: opacity var(--t-med) var(--ease);
  z-index: 900; backdrop-filter: blur(4px);
}
.drawer-backdrop.open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; right: 0; top: 0; bottom: 0; width: min(460px, 100%);
  background: var(--bg); border-left: 1px solid var(--line);
  transform: translateX(100%); transition: transform var(--t-med) var(--ease);
  z-index: 1000; overflow-y: auto; padding: 28px 28px 60px;
}
.drawer.open { transform: translateX(0); }
.drawer-close {
  position: sticky; top: 0; float: right;
  background: var(--surface); border: 1px solid var(--line);
  width: 32px; height: 32px; border-radius: 50%;
  color: var(--text); cursor: pointer; font-size: 16px;
  display: flex; align-items: center; justify-content: center;
}

/* ── Empty / error ── */
.muted { color: var(--text-mute); font-size: 13px; }
.empty { padding: 20px; text-align: center; color: var(--text-mute); font-size: 13px; }
.skel {
  background: linear-gradient(90deg, var(--surface) 0%, var(--surface-2) 50%, var(--surface) 100%);
  background-size: 200% 100%;
  animation: shimmer 1.6s ease-in-out infinite;
  border-radius: var(--r-sm);
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ── Hero fade transition on loc change ── */
.fade-in { animation: fadeIn var(--t-med) var(--ease); }
@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

/* Light-mode canvas dim */
html[data-theme="light"] .hero { background: linear-gradient(135deg, #d7e3f8 0%, #eef2fa 100%); border-color: rgba(12,28,58,0.12); }
html[data-theme="light"] .hero::after { background: radial-gradient(circle at 70% 20%, transparent 0%, rgba(244,247,252,0.35) 100%); }
html[data-theme="light"] .hero-temp { background: linear-gradient(180deg, #0b1f3a 0%, rgba(11,31,58,0.55) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

/* print */
@media print { .topbar, .locbar, .chip { display: none; } .hero-canvas { display: none; } }
</style>
