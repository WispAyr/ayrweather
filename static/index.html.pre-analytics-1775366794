const PRISM_BASE = 'https://artemis.wispayr.online/api';

function prismCard(label, value, sub, meta, mood, onClick) {
  const cls = mood ? `mood-${mood}` : '';
  return `<div class="prism-card ${cls}" onclick="${onClick}">
    <div class="prism-label">${label}</div>
    <div class="prism-value">${value}</div>
    ${sub?`<div class="prism-sub">${sub}</div>`:''}
    ${meta?`<div class="prism-meta">${meta}</div>`:''}
